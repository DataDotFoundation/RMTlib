import RMTlib.Fock.Pieri

/-!
# The Casimir of the left `gl_N` action on the Fock space

For an `N × N` matrix of variables `X`, the left action of `gl_N` on `ℚ[X]` is generated by the
polarisation operators

  `L_{ab} = Σ_j x_{aj} ∂/∂x_{bj}`   (`RMT.Fock.polar`),

and its Casimir is `C = Σ_{a,b} L_{ab} L_{ba}` (`RMT.Fock.cas`). Since `x_v` and `∂_v` are Fock
adjoint (`RMT.Fock.fischer_X_mul_left`), `L_{ab}` and `L_{ba}` are adjoint (`fischer_polar`), so
`C` is **Fock self-adjoint** (`fischer_cas`). That is the first input of the §6.4 induction of
`bridge/links/fock-norm.md`: eigenvectors of `C` with different eigenvalues are Fock orthogonal.

The second input is the eigenvalue `C s_λ(X) = e(λ) s_λ(X)`, `e(λ) = N|λ| + 2 Σ_{□ ∈ λ} c(□)`
(`RMT.Fock.casEig`). It is proved here for the empty shape and for `p₁ = s_{(1)}` (`cas_one`,
`cas_trX`) and, for every shape, it is the hypothesis of `RMT.Fock.fischer_sX_sX_of_casimir`.

The Leibniz rule (`cas_mul`) gives `C(tr X · f) = tr X · C f + N tr X · f + 2 D₁ f`
(`cas_trX_mul`), with `D₁ = Γ(tr X, ·) = Σ_{a,j} (X²)_{aj} ∂/∂x_{aj}` (`RMT.Fock.dOne`). Together
with Pieri (`RMT.Fock.trX_mul_sX`) this reduces the eigenvalue on `ν + □` to the content-weighted
Pieri rule `D₁ s_ν = Σ_□ c(□) s_{ν+□}`; see the docs for why this is not enough on its own.

**`ω`-symmetry.** The right action `R_{jk} = Σ_a x_{aj} ∂/∂x_{ak}` has the same Casimir (Howe
duality for `GL_N × GL_N`); the eigenvalue obeys `e^{(N)}(λᵀ) = −e^{(−N)}(λ)`, the same
`N ↦ −N`, `c ↦ −c` as the weight (`RMT.Places.archimedean_contentProd_transpose`).
-/

open MvPolynomial Finset

namespace RMT.Fock

variable {N : ℕ}

/-- The polarisation operator `L_{ab} = Σ_j x_{aj} ∂/∂x_{bj}`, the action of the elementary matrix
`E_{ab}` by left multiplication. -/
noncomputable def polar (a b : Fin N) (f : MvPolynomial (Fin N × Fin N) ℚ) :
    MvPolynomial (Fin N × Fin N) ℚ :=
  ∑ j, X (a, j) * pderiv (b, j) f

/-- **`L_{ab}` and `L_{ba}` are Fock adjoint.** -/
theorem fischer_polar (a b : Fin N) (f g : MvPolynomial (Fin N × Fin N) ℚ) :
    fischer (polar a b f) g = fischer f (polar b a g) := by
  classical
  rw [polar, fischer_sum_left, polar, fischer_sum_right]
  refine sum_congr rfl fun j _ => ?_
  rw [fischer_X_mul_left, fischer_comm f, fischer_X_mul_left, fischer_comm]

theorem polar_add (a b : Fin N) (f g : MvPolynomial (Fin N × Fin N) ℚ) :
    polar a b (f + g) = polar a b f + polar a b g := by
  simp only [polar, map_add, mul_add, sum_add_distrib]

/-- `L_{ab}` is a derivation. -/
theorem polar_mul (a b : Fin N) (f g : MvPolynomial (Fin N × Fin N) ℚ) :
    polar a b (f * g) = polar a b f * g + f * polar a b g := by
  simp only [polar, Derivation.leibniz, smul_eq_mul, mul_add, sum_add_distrib, sum_mul, mul_sum]
  rw [add_comm]
  congr 1 <;> exact sum_congr rfl fun j _ => by ring

theorem polar_C_mul (a b : Fin N) (r : ℚ) (f : MvPolynomial (Fin N × Fin N) ℚ) :
    polar a b (C r * f) = C r * polar a b f := by
  rw [polar_mul]
  simp [polar, mul_sum, mul_left_comm]

variable (N) in
/-- **The Casimir** `C = Σ_{a,b} L_{ab} L_{ba}` of the left `gl_N` action. -/
noncomputable def cas (f : MvPolynomial (Fin N × Fin N) ℚ) : MvPolynomial (Fin N × Fin N) ℚ :=
  ∑ a, ∑ b, polar a b (polar b a f)

/-- **The Casimir is Fock self-adjoint.** -/
theorem fischer_cas (f g : MvPolynomial (Fin N × Fin N) ℚ) :
    fischer (cas N f) g = fischer f (cas N g) := by
  rw [cas, fischer_sum_left, cas, fischer_sum_right]
  refine sum_congr rfl fun a _ => ?_
  rw [fischer_sum_left, fischer_sum_right]
  refine sum_congr rfl fun b _ => ?_
  rw [fischer_polar, fischer_polar]

theorem cas_add (f g : MvPolynomial (Fin N × Fin N) ℚ) : cas N (f + g) = cas N f + cas N g := by
  simp only [cas, polar_add, sum_add_distrib]

/-- **The Leibniz rule for the Casimir**: `C(f g) = C f · g + f · C g + 2 Γ(f, g)` with
`Γ(f, g) = Σ_{a,b} L_{ab} f · L_{ba} g`. -/
theorem cas_mul (f g : MvPolynomial (Fin N × Fin N) ℚ) :
    cas N (f * g) = cas N f * g + f * cas N g +
      2 * ∑ a, ∑ b, polar a b f * polar b a g := by
  have hsymm : ∑ a : Fin N, ∑ b : Fin N, polar b a f * polar a b g
      = ∑ a, ∑ b, polar a b f * polar b a g := sum_comm
  have e1 : cas N f * g = ∑ a, ∑ b, polar a b (polar b a f) * g := by simp only [cas, sum_mul]
  have e2 : f * cas N g = ∑ a, ∑ b, f * polar a b (polar b a g) := by simp only [cas, mul_sum]
  rw [e1, e2, two_mul, cas]
  simp only [polar_mul, polar_add, sum_add_distrib]
  rw [hsymm]
  abel

/-- The derivation `D₁ f = Γ(tr X, f) = Σ_{a,j} (X²)_{aj} ∂/∂x_{aj} f`. -/
noncomputable def dOne (f : MvPolynomial (Fin N × Fin N) ℚ) : MvPolynomial (Fin N × Fin N) ℚ :=
  ∑ a, ∑ b, X (a, b) * polar b a f

theorem polar_trX (a b : Fin N) : polar a b (trX N) = X (a, b) := by
  classical
  rw [polar, Fintype.sum_eq_single b fun j hj => by
    rw [trX, map_sum, Fintype.sum_eq_zero _ fun c => by
      rw [pderiv_X, Pi.single_apply, if_neg (by
        simp only [Prod.mk.injEq, not_and]
        exact fun h1 h2 => hj (h2.symm.trans h1))], mul_zero]]
  rw [pderiv_trX, mul_one]

/-- `L_{ab} x_v = δ_{v₁ b} x_{a v₂}`. -/
theorem polar_X (a b : Fin N) (v : Fin N × Fin N) :
    polar a b (X v) = if v.1 = b then X (a, v.2) else 0 := by
  classical
  rw [polar, Fintype.sum_eq_single v.2 fun j hj => by
    rw [pderiv_X, Pi.single_apply, if_neg (by simp [Prod.ext_iff]; tauto), mul_zero]]
  rw [pderiv_X, Pi.single_apply]
  by_cases h : v.1 = b
  · rw [if_pos (by ext <;> simp [h]), if_pos h, mul_one]
  · rw [if_neg (by simp [Prod.ext_iff]; tauto), if_neg h, mul_zero]

/-- **`C (tr X) = N tr X`**: `e((1)) = N`. -/
theorem cas_trX : cas N (trX N) = (N : ℚ) • trX N := by
  classical
  have h : ∀ a b : Fin N, polar a b (polar b a (trX N)) = X (a, a) := by
    intro a b
    rw [polar_trX, polar_X, if_pos rfl]
  rw [cas]
  simp only [h, sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul]
  rw [trX, smul_sum]
  refine sum_congr rfl fun a _ => ?_
  rw [smul_eq_C_mul, map_natCast]

/-- **`C 1 = 0`**: `e(∅) = 0`. -/
theorem cas_one : cas N (1 : MvPolynomial (Fin N × Fin N) ℚ) = 0 := by
  simp [cas, polar]

/-- **`C(tr X · f) = tr X · C f + N tr X · f + 2 D₁ f`.** -/
theorem cas_trX_mul (f : MvPolynomial (Fin N × Fin N) ℚ) :
    cas N (trX N * f) = trX N * cas N f + (N : ℚ) • (trX N * f) + 2 * dOne f := by
  rw [cas_mul, cas_trX, dOne]
  simp_rw [polar_trX]
  rw [smul_mul_assoc]
  ring

end RMT.Fock
