// This Magma program is associated to the paper
// Joint moments of derivatives of characteristic polynomials or of the Riemann zeta 
// function, by Paul-Olivier Dehaye

// It aims to show a working implementation, _not_ optimized for speed, of that paper.
// It also aims for clarity by computing objects as close as possible to the original paper.
// It is based on Equation (30).

// In short: THIS IS NOT OPTIMIZED FOR SPEED, but for simplicity


// // Example of use:
// data := [];
// AllMomentsComplexMUpTo(20,~data);   // this takes a while
// NumeratorNormedV(20,data);    // quick
// MomentComplexM(15,data);      // quick again
// AllMomentsComplexMUpTo(22,~data);   // this takes less time, because it's reusing everything done before
// NumeratorNormedV(22,data);    //quick again
 

K<k> := FunctionField(Rationals());

U<u> := PolynomialRing(Rationals());
// The field over which all of the numerators will be returned

m := hom<K->U|u/2>;
// The map from K to U. Remember u == 2*k

FrobeniusCoordinates := function(p1)
// Computes the Frobenius coordinates of the partition p1
// For instance, 
// > FrobeniusCoordinates([4,3,1]);
// <[ 3, 1 ], [ 2, 0 ]>
// > FrobeniusCoordinates(ConjugatePartition([4,3,1]));
// <[ 2, 0 ], [ 3, 1 ]>

     index := 1;
     while ((index le #p1) and (p1[index] ge index)) do index +:=1;end while;
     d := index-1;
     p2 := ConjugatePartition(p1);
     return <[p1[i]-i: i in [1..d]],[p2[i]-i: i in [1..d]]>;
end function;

DeterminantalPart := function(lambda)
// Computes the main determinant in each summand, associated with the partition lambda,
// given with Frobenius coordinates s,t of length d
    s := lambda[1];
    t := lambda[2];
    d := #s;
    M := Matrix(d,d,&cat[ [1 /Factorial(s[i])/Factorial(t[j])/(1+s[i]+t[j]) : j in [1..d]] : i in [1..d]]);
    return Determinant(M);
end function;

GammaPart := function(lambda)
// Computes the product of Gamma function part, as a function of the variable k defined above
// This could be optimized: since we know where poles and zeroes are initially potentially located, we could
// first figure its divisor, a matter of adding simple vectors based on the $\alpha_a(r)$ functions. 
// Then, we could see how far off from the common denominator (the $Q_r(u)$) this is, and multiply 
// by the appropriate polynomial. The interest of doing so is that the arithmetic would take place over a
// polynomial ring and not a function field. 
// We prefer to go for simplicity...
    s := lambda[1];
    t := lambda[2];
    d := #s;
    tmp := 1;
    for i := 1 to d do
        tmp *:= &*[ k+z: z in [-t[i]..s[i] ]];
    end for;
    for i := 1 to d do
        tmp /:= &*[ 2*k+z: z in [-t[i]..s[i] ]];
    end for;
    return tmp;
end function;

ComputeMomentComplexM := function(r)
// This returns (M)_r(2k) / M_0(2k) * i^r as a rational function of k,
//  i.e. the unsigned, real version without the G(k+1)^2/G(2k+1) factor
   print "Computing...",r;
   if r eq 0 then 
       return 1; 
   end if;
   partitions := Partitions(r);
   frobPartitions := [FrobeniusCoordinates(partition): partition in partitions];

   tmp := 0;
   for frobPartition in frobPartitions do
       tmp +:= DeterminantalPart(frobPartition)^2 * GammaPart(frobPartition);
   end for;
   return Factorial(r)*tmp;

//    BAD IDEA:
//    return Factorial(r)* &+[DeterminantalPart(frobPartition)^2 * GammaPart(frobPartition): frobPartition in frobPartitions];
//    bad idea because Magma has to save a huge sequence of nasty rational functions, before summing it up.
end function;

AllMomentsComplexMUpTo := procedure(R,~allMoments) 
// This computes all the moments (M)_r(u) up to r = R, starting at r=0
// and assigns it to the variable allMoments
   current := #allMoments-1; 
   if current lt R then 
      allMoments cat:= [ComputeMomentComplexM(r): r in [current+1..R]];
   end if;
end procedure;

function OddError(r)
// for the cases where we assume r = 2*h
    if IsOdd(r) then
        print "We can only compute even moments";
        assert false;
    end if;
    return r div 2;
end function;

procedure TestEnoughData(r,allMoments)
// We need to have computed the first (M)_i(2k) for i in [0..r] to be able to compute |M|_j(2k) or |V|_j(2k) for j <= r
   if r+1 gt #allMoments then
       print "We need to compute more complex moments first";
       print "You have given the first ",#allMoments, "moments (M)_i (2k), for i between 0 and ",#allMoments-1,". I need more complex moments though, please run AllMomentsComplexMUpTo more";
       assert false; 
   end if;
end procedure;


MomentComplexM := function(r,allMoments)
// Returns  (M)_r(2k) / (M)_0(2k)  as a rational function of k
// without the G(k+1)^2/G(2k+1) factor or the power of i in front
// this assumes that allMoments is long enough...
    TestEnoughData(r,allMoments);
    return allMoments[r+1];
end function;



MomentNormedM := function(r,allMoments)
// Returns  |M|_r(2k) / |M|_0(2k) as a rational function of k
// i.e. the moments without the G(k+1)^2/G(2k+1) factor
// this assumes that allMoments is long enough...
    h := OddError(r);
    TestEnoughData(r,allMoments);
    return (-1)^h * &+[Binomial(h,j) *(-1)^j* allMoments[2*h-j+1]: j in [0..h]];
end function;


// The following two functions provide the same output, but would give different analytic
// continuations if extended beyond their range of validity
MomentNormedV2 := function(r,allMoments) 
// Returns  |V|_r(2k) / |V|_0(2k) as a rational function of k
// i.e. the moments without the G(k+1)^2/G(2k+1) factor
    h := OddError(r);
    TestEnoughData(r,allMoments);
    return (-1)^h * &+[Binomial(2*h,j) *(-1/2)^j* allMoments[2*h-j+1]: j in [0..2*h]];
end function;

MomentNormedV := function(r,allMoments)
// Returns  |V|_r(2k) / |V|_0(2k) as a rational function of k
// i.e. the moments without the G(k+1)^2/G(2k+1) factor
    h := OddError(r);
    return (-1/4)^h * &+[(-4)^j * Binomial(h,j) * MomentNormedM(2*j,allMoments):j in [0..h]];
end function;

alpha := function(a,r)
// alpha(a,r) as in paper
    return Floor((-a+Sqrt(a^2+4*r))/2);
end function;

Y := function(r,uVar)
// Y_r(uVar) as in paper, denominator for the various moments
// see remark above at function GammaPart for potential optimization
     tmp := 1;
     for l := 1 to r-1 do
        if IsOdd(l) then 
           tmp *:= (uVar^2-l^2)^(alpha(l,r));
        end if;
     end for; 
     return tmp;
end function;

ComputeNumeratorComplexM := function(r) 
// Numerator X_r(u)
    return m(ComputeMomentComplexM(r)*Y(r,2*k)*2^r);
end function;

NumeratorComplexM := function(r,allMoments) 
// Numerator X_r(u)
    return m(MomentComplexM(r,allMoments)*Y(r,2*k)*2^r);
end function;

NumeratorNormedM := function(r,allMoments) 
// Numerator \hat{X}_r(u)
    h := OddError(r);
    return m(MomentNormedM(r,allMoments)*Y(r,2*k))*2^r;
end function;

NumeratorNormedV := function(r,allMoments)
// Numerator \tilde{X}_r(u)
    h := OddError(r);
    return m(MomentNormedV(r,allMoments)*Y(r,2*k))*2^(3*h)*Factorial(h)/Factorial(r);
end function;
